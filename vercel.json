{
  "version": 2,
  "builds": [{ "src": "backend/server.js", "use": "@vercel/node" }],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/fullscreen",
      "destination": "/frontend/public/fullscreen.html"
    },
    {
      "source": "/fullscreen-cvcrm",
      "destination": "/frontend/public/fullscreen-cvcrm.html"
    }
  ]
}
