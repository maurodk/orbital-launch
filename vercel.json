{
  "version": 2,
  "builds": [{ "src": "deploy-docker/backend/server.cjs", "use": "@vercel/node" }],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/deploy-docker/backend/server.cjs"
    },
    {
      "source": "/mobile",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/fullscreen",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/fullscreen-cvcrm",
      "destination": "/frontend/index.html"
    }
  ]
}
